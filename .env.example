# OpenAI API Key
OPENAI_API_KEY=sk-your-api-key-here

# ============================================================
# Pipeline Settings
# ============================================================

# Languages (required): ko, en, ja, zh-CN, zh-TW, es, fr, de
PIPELINE_SOURCE_LANGUAGE=en
PIPELINE_TARGET_LANGUAGE=ko

# OpenAI model
# PIPELINE_MODEL=gpt-4.1-mini

# Preprocessing: max characters per chunk
# PIPELINE_CHUNK_SIZE=4000

# Translation: max characters per batch
# PIPELINE_BATCH_SIZE=4000

# Concurrency: max parallel API calls
# PIPELINE_PREPROCESS_MAX_CONCURRENT=20
# PIPELINE_TRANSLATION_MAX_CONCURRENT=20

# Retry: exponential backoff settings
# PIPELINE_MAX_RETRIES=3
# PIPELINE_BASE_DELAY=1.0

# Paths
# PIPELINE_OUTPUT_DIR=./output
# PIPELINE_CHECKPOINT_DIR=./checkpoints
